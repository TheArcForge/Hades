<UserControl x:Class="Hades.Shell.Sections.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Hades.Shell.ViewModels">

    <UserControl.Resources>
        <vm:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <vm:OnOffConverter x:Key="OnOff" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Border Padding="10,8" Margin="0,0,0,12" BorderThickness="1"
                    Visibility="{Binding RefreshError, Converter={StaticResource EmptyToCollapsed}}">
                <TextBlock Text="{Binding RefreshError}" TextWrapping="Wrap" />
            </Border>

            <!-- The core's two settings. Read-only here: this section reports what the core decided,
                 it does not change it. -->
            <TextBlock Text="Core" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />

            <StackPanel Margin="0,0,0,16"
                        Visibility="{Binding Settings, Converter={StaticResource EmptyToCollapsed}}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="MCP port" Width="140" Opacity="0.75" />
                    <TextBlock Text="{Binding Settings.McpPort.Port}" />
                </StackPanel>

                <!-- The core's own sentence about whether the port is usable, verbatim. Deliberately
                     NOT rebuilt here out of port and inUse. -->
                <TextBlock Text="{Binding Settings.McpPort.Message}"
                           Margin="140,2,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                    <TextBlock Text="Log level" Width="140" Opacity="0.75" />
                    <TextBlock Text="{Binding Settings.LogLevel.Level}" />
                </StackPanel>
            </StackPanel>

            <!-- The two OS facts the core cannot observe: it is a separate, headless process. -->
            <TextBlock Text="This computer" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />

            <!--
              TWO-WAY, and no Click handler. This was OneWay plus a Click handler that assigned
              IsChecked to snap the box back to what the OS reported - which quietly broke it two
              ways, both measured on a real machine:

                - Assigning a dependency property that carries a binding REPLACES the binding with a
                  local value. From the first click onward the box no longer tracked the view model,
                  so the veto Windows writes when the entry is disabled in Task Manager was read
                  correctly and never reached the screen. A never-clicked instance tracked it live;
                  a clicked one stayed "on" through a real veto. That is precisely the lie this
                  feature exists to prevent.
                - WPF's TogglePattern.Toggle(), which is what a screen reader or voice control
                  invokes, calls OnToggle() WITHOUT raising Click - so the setting could not be
                  changed by assistive technology at all. Toggling it that way wrote nothing.

              The snap-back is not lost: the view model's setter writes, then stores what the OS
              reports and always raises PropertyChanged, so a refused request pulls the box back.
            -->
            <CheckBox x:Name="LaunchAtLoginToggle"
                      Content="Start Hades when I sign in"
                      IsChecked="{Binding LaunchAtLoginEnabled, Mode=TwoWay}"
                      Margin="0,4" />

            <!-- Display-only, matching the Mac's treatment of Low Power Mode. Nothing in the shell
                 acts on it. -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                <TextBlock Text="Battery saver" Width="140" Opacity="0.75" />
                <TextBlock Text="{Binding IsBatterySaverOn, Converter={StaticResource OnOff}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
