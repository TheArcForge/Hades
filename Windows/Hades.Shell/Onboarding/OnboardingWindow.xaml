<Window x:Class="Hades.Shell.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Hades.Shell.ViewModels"
        Title="Welcome to Hades"
        Height="480" Width="680"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <!-- Like MainWindow, no colours are named: the active theme supplies them. -->

    <Window.Resources>
        <vm:NodeCountConverter x:Key="NodeCount" />
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StepTitle" Grid.Row="0" FontSize="24" FontWeight="SemiBold" />

        <!-- "Step N of 4". Built from AllSteps.Length rather than written down, so the count cannot
             drift from the sequence the way the Mac's own hardcoded "five steps" copy did. -->
        <TextBlock x:Name="StepCounter" Grid.Row="1" Opacity="0.7" FontSize="12" Margin="0,4,0,0" />

        <TextBlock x:Name="StepCopy" Grid.Row="2" TextWrapping="Wrap" FontSize="14"
                   Margin="0,18,0,0" VerticalAlignment="Top" LineHeight="21" />

        <StackPanel Grid.Row="2" x:Name="ClaudeCodePanel" Margin="0,120,0,0" VerticalAlignment="Top"
                    Visibility="Collapsed">
            <Button x:Name="CheckButton" Content="Check now" Click="OnCheckClaudeCode"
                    Padding="14,5" HorizontalAlignment="Left" />
            <TextBlock x:Name="CheckResult" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <!-- The Projects step's own action. Its absence was a real bug: the copy said "Add a Unity
             project" beside nothing but Skip and Next.

             Indexing is SYNCHRONOUS server-side - POST /control/projects/add calls AdoptAndIndex
             before it answers - so this genuinely waits, ~6s for a 6,800-file project and longer on
             the first add after launch. A disabled button and the word "Adding…" left that looking
             frozen, so the wait gets a real indeterminate bar. -->
        <StackPanel Grid.Row="2" x:Name="ProjectsPanel" Margin="0,120,0,0" VerticalAlignment="Top"
                    Visibility="Collapsed">
            <Button x:Name="AddProjectButton" Content="Add project…" Click="OnAddProject"
                    Padding="14,5" HorizontalAlignment="Left" />
            <ProgressBar x:Name="AddProjectProgress" IsIndeterminate="True" Height="4" Width="220"
                         Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed" />
            <TextBlock x:Name="AddProjectResult" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" />

            <!-- What actually got added, so "Added and indexed." is not the only evidence. -->
            <ItemsControl x:Name="AddedProjectsList" Margin="0,12,0,0" MaxHeight="120">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <!-- Without this the row announces the raw record - "ProjectRow { Name = ...,
                     Path = ..., ProductGuid = ..., NodeCount = ..., Warnings =
                     System.Collections.Generic.List`1[...] }" - because an ItemsControl's item peer
                     falls back to the bound object's ToString(). Same defect and same fix as
                     MemoryView and TracesView already carry; this window was simply missed, and the
                     Task 12 Step 8 walk is what found it. -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name">
                            <Setter.Value>
                                <MultiBinding StringFormat="{}{0}, {1}, {2}">
                                    <Binding Path="Name" />
                                    <Binding Path="IndexStatus" />
                                    <Binding Path="NodeCount" Converter="{StaticResource NodeCount}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            <!-- The count goes through NodeCountConverter rather than a bare Run
                                 followed by the literal word "nodes", which said "1 nodes". -->
                            <TextBlock FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding IndexStatus, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding NodeCount, Mode=OneWay, Converter={StaticResource NodeCount}}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Per project, not one nameless button. "Install plugin" alone could not say WHICH project
             it meant, and with several added the answer mattered - the Mac's own step lists every
             project with its own button for exactly that reason. -->
        <StackPanel Grid.Row="2" x:Name="UnityPluginPanel" Margin="0,104,0,0" VerticalAlignment="Top"
                    Visibility="Collapsed">
            <TextBlock x:Name="NoProjectsToInstallInto" FontSize="13" TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Text="No projects yet - add one on the previous step and it will appear here." />

            <ItemsControl x:Name="PluginProjectsList" MaxHeight="150">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <!-- Same reason as the Projects list above, and worse here: PluginRow is a class,
                     not a record, so the row announced the bare type name
                     "Hades.Shell.Onboarding.PluginRow" - not even the project it refers to. The row
                     names the project; the button and the "✓ Installed" text inside it are announced
                     on their own, so the state is not lost by keeping this to the identity. -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                       FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                       ToolTip="{Binding Path}" />
                            <Button Grid.Column="1" Content="Install plugin" Padding="12,4"
                                    Click="OnInstallPlugin" Tag="{Binding ProductGuid}"
                                    Visibility="{Binding ButtonVisibility}" />

                            <!-- Replaces the button once this row is done, so a finished row cannot
                                 look identical to an untouched one. Green is carried by the tick and
                                 the word together - colour alone would say nothing to anyone who
                                 cannot see it. -->
                            <TextBlock Grid.Column="1" Text="✓ Installed" VerticalAlignment="Center"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#2C6E49"
                                       Visibility="{Binding DoneVisibility}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ProgressBar x:Name="InstallPluginProgress" IsIndeterminate="True" Height="4" Width="220"
                         Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="Collapsed" />
            <TextBlock x:Name="InstallPluginResult" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SkipButton" Content="Skip" Click="OnSkip" Padding="14,5" Margin="0,0,8,0" />
            <Button x:Name="NextButton" Content="Next" Click="OnNext" Padding="18,5" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
