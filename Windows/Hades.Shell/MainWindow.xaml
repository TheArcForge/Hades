<Window x:Class="Hades.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Hades.Shell.ViewModels"
        xmlns:sections="clr-namespace:Hades.Shell.Sections"
        Title="Hades"
        Height="600" Width="900"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen">

    <!-- No Background or Foreground is set anywhere in this file, deliberately. Spec #5 §5.5 says
         the shell must look acceptable under the DEFAULT WPF theme while using Fluent where it
         helps, and the way to satisfy both is to name no colours at all: whichever theme is active
         supplies them. Hardcoding a palette here is what makes a window that is only legible in the
         theme the developer happened to be using. -->

    <Window.Resources>
        <vm:SectionTitleConverter x:Key="SectionTitle" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sidebar. SelectedItem binds two-way straight to the view model's SelectedSection,
             so navigation state lives in one place rather than being mirrored between the two. -->
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                 BorderThickness="0"
                 Padding="4,8">

            <!--
              THE ACCESSIBLE NAME MUST BE THE NAME ON SCREEN, and without this it was not.

              A ListBoxItem with no explicit AutomationProperties.Name takes it from the bound
              item's ToString() - here the Section enum - so assistive technology announced "Traces"
              and "Memory" while the sidebar read "Charon" and "Asphodel". Measured with UI
              Automation, not assumed. That is a real defect twice over: a screen reader speaks a
              word that is nowhere on screen, and voice control cannot act on "click Charon" because
              no element claims that name.

              It matters more here than it would elsewhere because those two names are deliberate
              product vocabulary this plan explicitly refuses to rename to generic labels - so the
              generic label leaking out through the accessibility tree is precisely the outcome that
              decision was meant to prevent.

              Bound through the SAME converter the visible TextBlock uses, so the two cannot drift:
              whatever Section.Title() returns is both what is drawn and what is announced.
            -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding Converter={StaticResource SectionTitle}}" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource SectionTitle}}"
                               Padding="8,6"
                               FontSize="14" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- One host, whose template is chosen by the selected section. Each section's view gets
             its OWN view model as DataContext (see MainWindow.xaml.cs) - MainWindowViewModel owns
             navigation and the poll lifecycle, never a section's data. Tasks 8 and 9 replace the
             remaining placeholders the same way Projects is wired here. -->
        <ContentControl Grid.Column="1" Content="{Binding SelectedSection}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Margin="24,20" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Converter={StaticResource SectionTitle}}"
                                               FontSize="24"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="This section is not built yet."
                                               Margin="0,8,0,0"
                                               Opacity="0.7"
                                               FontSize="13" />
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedSection}" Value="Projects">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <!-- The section's own view model comes off the WINDOW, not
                                             off MainWindowViewModel: that type owns navigation and
                                             the poll lifecycle and deliberately holds no section
                                             data, so composing the sections is the view layer's
                                             job. -->
                                        <sections:ProjectsView
                                            DataContext="{Binding Projects,
                                                          RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding SelectedSection}" Value="Traces">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <sections:TracesView
                                            DataContext="{Binding Traces,
                                                          RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding SelectedSection}" Value="Memory">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <sections:MemoryView
                                            DataContext="{Binding Memory,
                                                          RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding SelectedSection}" Value="Settings">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <sections:SettingsView
                                            DataContext="{Binding Settings,
                                                          RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Window>
