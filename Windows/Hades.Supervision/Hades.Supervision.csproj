<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The supervisor library: spawns the core, adopts one already running, restarts it with
    backoff, and guarantees a spawned core never outlives its parent via a Job Object with
    JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE (the Windows equivalent of Mac's HadesCoreReaper).
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\src\Hades.Control.Client\Hades.Control.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows/ pins versions inline rather than through central package management (that's a
         Core/ convention - see Core/Directory.Packages.props). -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="..\..\BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

</Project>
