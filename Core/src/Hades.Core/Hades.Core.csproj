    <EmbeddedResource Include="..\..\..\UnityPlugin\Assets\Hades\Tools\ProjectCommands.cs">
      <LogicalName>Hades.Plugin.Tools.ProjectCommands.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\UnityPlugin\Assets\Hades\Transport\HadesClient.cs">
