# Node — dependencies are never committed
Bridge~/node_modules/
Bridge~/hub/node_modules/
Scanner~/node_modules/
Dashboard~/node_modules/

# Note: compiled output IS committed on purpose (shipped prebuilt, zero native deps):
#   Bridge~/launcher/dist, Bridge~/hub/dist  -> consumed by the Claude Code plugin
#   Dashboard~/dist                          -> served by the Unity Editor at runtime
# Scanner~ ships as source (native tree-sitter deps are built per-platform via npm install).

# Hades runtime artifacts (machine-specific)
.arcforge/graph.db
.arcforge/graph.db-wal
.arcforge/graph.db-shm
.arcforge/traces.db
.arcforge/server.json
.arcforge/config.local.yaml
.arcforge/hades-hub/

# Keep memory tracked
!.arcforge/memory/

# .mcp.json is deliberately NOT ignored. Its only Hades entry is
# `node .arcforge/hades-hub/launcher.js` — a project-relative path that is byte-identical on every
# machine and under either hub scope, so it is team config, not machine state. Claude Code reads
# any number of other servers from the same file; Hades merges rather than overwrites.
# The launcher it names IS ignored (above), so a fresh clone reports the server as failed until
# the Unity Editor has been opened once to regenerate it.

# Superpowers artifacts
docs/
docs.meta
