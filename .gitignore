# Node — dependencies are never committed
Bridge~/node_modules/
Bridge~/hub/node_modules/
Scanner~/node_modules/
Dashboard~/node_modules/

# Note: compiled output IS committed on purpose (shipped prebuilt, zero native deps):
#   Bridge~/launcher/dist, Bridge~/hub/dist  -> consumed by the Claude Code plugin
#   Dashboard~/dist                          -> served by the Unity Editor at runtime
# Scanner~ ships as source (native tree-sitter deps are built per-platform via npm install).

# Hades runtime artifacts (machine-specific)
.arcforge/graph.db
.arcforge/graph.db-wal
.arcforge/graph.db-shm
.arcforge/traces.db
.arcforge/server.json
.mcp.json

# LLVM coverage output from the Xcode-instrumented HadesApp binary, written to its process CWD
# on exit (seen at the repo root and at Shell~/HadesApp). Regenerated every run, never committed.
# Bare filenames match at any depth, so this covers both locations. The .meta entry is needed
# because Unity generates a .meta for anything sitting at the repo root.
default.profraw
default.profraw.meta

# Keep memory tracked
!.arcforge/memory/

# Superpowers artifacts
docs/
docs.meta
