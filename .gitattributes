# Normalize line endings
* text=auto

# Unity YAML
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.meta text eol=lf
*.asmdef text eol=lf

# Source code
*.cs text diff=csharp eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.fbx binary
*.obj binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
